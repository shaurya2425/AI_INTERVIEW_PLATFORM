
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  UNASSIGNED
  INTERVIEWEE
  INTERVIEWER
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum PayoutStatus {
  PROCESSING
  PROCESSED
}

enum InterviewCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DSA
  SYSTEM_DESIGN
  BEHAVIORAL
  DEVOPS
  MOBILE
}

enum FeedbackRating {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
}

enum TransactionType {
  CREDIT_PURCHASE
  BOOKING_DEDUCTION
  BOOKING_EARNING
  ADMIN_ADJUSTMENT
}

// ─── USER ────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  imageUrl    String?
  role        UserRole @default(UNASSIGNED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // interviewee-only
  credits                 Int       @default(0)
  currentPlan             String    @default("free")
  creditsLastAllocatedAt  DateTime?

  // interviewer-only
  bio           String?
  title         String?
  company       String?
  yearsExp      Int?
  categories    InterviewCategory[]
  creditRate    Int       @default(1)
  creditBalance Int       @default(0)

  availabilities        Availability[]
  bookingsAsInterviewee Booking[]           @relation("IntervieweeBookings")
  bookingsAsInterviewer Booking[]           @relation("InterviewerBookings")
  transactions          CreditTransaction[]
  payouts               Payout[]
  authoredQuestions     InterviewQuestion[] @relation("QuestionAuthor")
  assignedQuestions     InterviewQuestion[] @relation("QuestionRecipient")
  interviewSubmissions  InterviewSubmission[]
}

// ─── AVAILABILITY ────────────────────────────────────────

model Availability {
  id           String             @id @default(uuid())
  interviewerId String
  interviewer  User               @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  status       AvailabilityStatus @default(AVAILABLE)

  @@index([interviewerId, startTime])
}

// ─── BOOKINGS ────────────────────────────────────────────

model Booking {
  id             String        @id @default(uuid())
  intervieweeId  String
  interviewee    User          @relation("IntervieweeBookings", fields: [intervieweeId], references: [id])
  interviewerId  String
  interviewer    User          @relation("InterviewerBookings", fields: [interviewerId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(SCHEDULED)
  creditsCharged Int
  streamCallId   String?       @unique
  recordingUrl   String?
  completedAt    DateTime?
  completedBy    String?
  completionState String @default("NONE")
  completionToken String?
  completionStartedAt DateTime?
  completionError String?
  streamEndedAt DateTime?
  feedbackState String @default("NONE")
  feedbackRequestedAt DateTime?
  transcriptArtifacts Json?
  recordingArtifacts Json?
  scoringSummary Json?
  scoringPolicyVersion String?
  feedback       Feedback?
  transactions   CreditTransaction[]
  reminders      InterviewReminder[]
  questions      InterviewQuestion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([status, startTime])
  @@index([interviewerId, status])
  @@index([intervieweeId, status])
}

model InterviewReminder {
  id             String   @id
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipientId    String
  scheduledStart DateTime
  minutesBefore  Int
  payload        Json
  sentAt         DateTime?
  providerId     String?
  attempts       Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())

  @@index([bookingId])
}

model InterviewQuestion {
  id                 String @id
  bookingId          String
  booking            Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sourceId           String
  authorId           String
  author             User @relation("QuestionAuthor", fields: [authorId], references: [id])
  recipientId        String
  recipient          User @relation("QuestionRecipient", fields: [recipientId], references: [id])
  question           String @db.Text
  topic              String
  category           String
  type               String
  difficulty         String
  options            String[]
  referenceAnswer    String @db.Text
  correctOptionIndex Int?
  sentAt             DateTime?
  createdAt          DateTime @default(now())
  submission         InterviewSubmission?
  parentId           String?
  parent             InterviewQuestion? @relation("GrillQuestions", fields: [parentId], references: [id], onDelete: SetNull)
  followUps          InterviewQuestion[] @relation("GrillQuestions")
  depth              Int @default(0)
  responseStatus     String @default("AWAITING_ANSWER")

  @@unique([bookingId, sourceId])
  @@index([recipientId])
  @@index([authorId])
}

model InterviewSubmission {
  id          String @id
  questionId  String @unique
  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User @relation(fields: [candidateId], references: [id])
  answer      String @db.Text
  optionIndex Int?
  language    String?
  submittedAt DateTime @default(now())
  notifiedAt  DateTime?
  evaluationStatus String @default("PENDING")
  evaluation Json?
  evaluationError String?
  evaluationStartedAt DateTime?
  evaluationToken String?
  evaluationAttempts Int @default(0)
  approvedGrade FeedbackRating?
  interviewerNotes String? @db.Text
  approvedAt DateTime?
  approvedBy String?
  evaluationCompletedAt DateTime?
  suggestedScore Int?
  approvedScore Int?
  scoringPolicyVersion String?
  difficultyWeight Float?
  followUpMultiplier Float?
  questionWeight Float?
  weightedScore Float?

  @@index([candidateId])
}

// ─── FEEDBACK ────────────────────────────────────────────

model Feedback {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  summary        String         @db.Text
  technical      String         @db.Text
  communication  String         @db.Text
  problemSolving String         @db.Text
  recommendation String
  strengths      String[]
  improvements   String[]
  overallRating  FeedbackRating
  sessionRating  Int?
  sessionComment String?        @db.Text
  createdAt      DateTime       @default(now())
}

// ─── CREDIT TRANSACTIONS ─────────────────────────────────

model CreditTransaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      TransactionType
  bookingId String?
  booking   Booking?        @relation(fields: [bookingId], references: [id])
  createdAt DateTime        @default(now())
}

// ─── PAYOUTS ─────────────────────────────────────────────

model Payout {
  id            String       @id @default(uuid())
  interviewerId String
  interviewer   User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  credits       Int
  platformFee   Float
  netAmount     Float
  paymentMethod String
  paymentDetail String
  status        PayoutStatus @default(PROCESSING)
  adminNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?
  processedBy   String?

  @@index([status, createdAt])
  @@index([interviewerId, status])
}
